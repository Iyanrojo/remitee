rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    match /profiles/{uid} {
      allow read: if verified();
      allow write: if verified() && request.auth.uid == uid;
    }
    match /private/{uid} {
      allow read, write: if verified() && request.auth.uid == uid;
    }
    // Galería de fotos de intereses: de momento solo la lee su dueño (cuando haya matches reales, también sus matches)
    match /gallery/{uid} {
      allow read, write: if verified() && request.auth.uid == uid;
    }
    // Emails salientes (extensión Trigger Email): cada persona solo puede dejar uno de bienvenida, para su propio email
    match /mail/{id} {
      allow create: if verified() && id == "welcome_" + request.auth.uid
        && request.resource.data.to == request.auth.token.email
        && request.resource.data.uid == request.auth.uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
