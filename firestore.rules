rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil público: lo pueden leer las personas registradas; solo lo escribe su dueño.
    match /profiles/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Datos privados (email y dirección postal): solo los lee y escribe su dueño.
    // La oficina de Remitee accede desde el servidor con permisos de administrador, no desde la web.
    match /private/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Todo lo demás, cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
