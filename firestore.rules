rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    // Administración: el email del propietario o cualquier cuenta con documento en admins/{uid}
    // (los documentos de admins se crean a mano en la consola de Firebase).
    function isAdmin() {
      return verified() && (request.auth.token.email in ["iyanrojo@gmail.com"]
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }
    match /admins/{uid} {
      allow get: if verified() && request.auth.uid == uid;
      allow read: if isAdmin();
    }
    match /profiles/{uid} {
      allow read: if verified();
      // Su dueño no puede tocar "hidden" (moderación) ni "plus" (Remitee Plus y tick azul): eso solo lo hace administración
      allow create: if verified() && request.auth.uid == uid
        && !("hidden" in request.resource.data) && !("plus" in request.resource.data);
      allow update: if (verified() && request.auth.uid == uid
          && request.resource.data.get("hidden", false) == resource.data.get("hidden", false)
          && request.resource.data.get("plus", false) == resource.data.get("plus", false))
        || isAdmin();
    }
    match /private/{uid} {
      allow read, write: if verified() && request.auth.uid == uid;
      allow read: if isAdmin();
    }
    // Galería de fotos de intereses: la lee su dueño y administración (moderación)
    match /gallery/{uid} {
      allow read, write: if verified() && request.auth.uid == uid;
      allow read: if isAdmin();
    }
    // "Quiero escribirle": cada like es un documento con id "<de>_<para>"
    match /likes/{id} {
      allow create, update: if verified() && request.resource.data.from == request.auth.uid
        && id == request.auth.uid + "_" + request.resource.data.to;
      allow get: if verified() && (id.matches(request.auth.uid + "_.*") || id.matches(".*_" + request.auth.uid));
      allow list: if isAdmin();
    }
    // Emails salientes (extensión Trigger Email): cada persona solo puede dejar uno de bienvenida, para su propio email
    match /mail/{id} {
      allow create: if verified() && id == "welcome_" + request.auth.uid
        && request.resource.data.to == request.auth.token.email
        && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
